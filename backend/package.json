{
  "name": "magic-collection-backend",
  "version": "1.2.0",
  "description": "Backend Express — Magic Collection Manager",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run migrate && node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node-pg-migrate up -m migrations --no-check-order",
    "migrate:down": "node-pg-migrate down -m migrations",
    "migrate:create": "node-pg-migrate create -m migrations",
    "sync:bulk": "node src/scripts/syncBulk.js",
    "sync:fr": "node src/scripts/syncFrenchNames.js",
    "job:daily": "node src/scripts/runDailyJob.js",
    "lint": "eslint src test",
    "test": "node --test --test-concurrency=1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^9.0.0",
    "otplib": "^13.6.0",
    "p-queue": "^8.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^17.14.0",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "glob": "^14.0.2"
  }
}
