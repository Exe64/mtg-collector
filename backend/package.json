{
  "name": "magic-collection-backend",
  "version": "1.0.0",
  "description": "Backend Express — Magic Collection Manager",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run migrate && node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node-pg-migrate up -m migrations --no-check-order",
    "migrate:down": "node-pg-migrate down -m migrations",
    "migrate:create": "node-pg-migrate create -m migrations",
    "sync:bulk": "node src/scripts/syncBulk.js",
    "job:daily": "node src/scripts/runDailyJob.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^5.6.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-pg-migrate": "^7.9.1",
    "p-queue": "^8.0.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "stream-json": "^1.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0"
  }
}
