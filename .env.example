# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
DB_USER=magic_user
DB_PASSWORD=changeme

# ---------------------------------------------------------------------------
# JWT  (générer chaque secret avec : openssl rand -hex 64)
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
# Cookie refresh token : true en HTTPS (prod), false en dev HTTP local
COOKIE_SECURE=true
# Nombre de proxys de confiance devant le backend (vraie IP client / rate-limit).
# 2 = prod Traefik → nginx ; 1 = compose local (nginx seul).
TRUST_PROXY=2
# Dead-man's-switch du job prix (ex. healthchecks.io). Vide = désactivé.
HEALTHCHECK_PRICE_URL=
# Détection des nouvelles versions (GitHub Releases). Vide = dépôt officiel, sans token.
# UPDATES_REPO=Exe64/mtg-collector
# UPDATES_GITHUB_TOKEN=
# Dossier partagé avec l'agent de mise à jour (deploy/updater/install.sh). Chemin absolu.
# MTG_UPDATES_DIR=/opt/mtg-collector/updates
# Fichiers compose utilisés par l'agent s'il y en a plusieurs :
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# ---------------------------------------------------------------------------
# Sauvegardes  (lues par deploy/backup-db.sh ; voir doc/backups.md)
# ---------------------------------------------------------------------------
# MTG_BACKUP_DIR=/opt/mtg-collector-backups
# MTG_BACKUP_PASSPHRASE_FILE=/root/.mtg-backup-pass
# MTG_RCLONE_REMOTE=gdrive:mtg-backups
# MTG_HEALTHCHECK_URL=        # dead-man's-switch du backup (healthchecks.io)

# ---------------------------------------------------------------------------
# Scryfall  (User-Agent obligatoire — mets un vrai contact)
# ---------------------------------------------------------------------------
SCRYFALL_USER_AGENT=MagicCollectionManager/1.0 (contact@example.com)

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PROD — servir en HTTPS. Renseigner DOMAIN + passer COOKIE_SECURE=true.
#   - VPS avec Traefik existant (docker-compose.vps.yml) : DOMAIN + TRAEFIK_CERTRESOLVER
#   - Serveur nu avec Caddy (docker-compose.prod.yml)     : DOMAIN + ACME_EMAIL
# ---------------------------------------------------------------------------
DOMAIN=
TRAEFIK_CERTRESOLVER=letsencrypt
ACME_EMAIL=
