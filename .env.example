# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
DB_USER=magic_user
DB_PASSWORD=changeme

# ---------------------------------------------------------------------------
# JWT  (générer chaque secret avec : openssl rand -hex 64)
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
# Cookie refresh token : true en HTTPS (prod), false en dev HTTP local
COOKIE_SECURE=true
# Nombre de proxys de confiance devant le backend (vraie IP client / rate-limit).
# 2 = prod Traefik → nginx ; 1 = compose local (nginx seul).
TRUST_PROXY=2

# ---------------------------------------------------------------------------
# Scryfall  (User-Agent obligatoire — mets un vrai contact)
# ---------------------------------------------------------------------------
SCRYFALL_USER_AGENT=MagicCollectionManager/1.0 (contact@example.com)

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PROD — servir en HTTPS. Renseigner DOMAIN + passer COOKIE_SECURE=true.
#   - VPS avec Traefik existant (docker-compose.vps.yml) : DOMAIN + TRAEFIK_CERTRESOLVER
#   - Serveur nu avec Caddy (docker-compose.prod.yml)     : DOMAIN + ACME_EMAIL
# ---------------------------------------------------------------------------
DOMAIN=
TRAEFIK_CERTRESOLVER=letsencrypt
ACME_EMAIL=
